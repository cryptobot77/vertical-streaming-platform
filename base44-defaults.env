# Development defaults for the Base44 sandbox preview.
#
# These are NOT real credentials — they only keep the app booting when no real
# value has been supplied yet. A real value stored as an app secret arrives in
# /run/base44/app.env, which is loaded AFTER this file in docker-compose.base44.yml,
# so the real value always wins.
#
# Stripe (subscription checkout) and Mux (video upload/playback) are external
# services: replace these with real values to make those features work.
STRIPE_SECRET_KEY=sk_test_base44_placeholder
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_base44_placeholder
STRIPE_WEBHOOK_SECRET=whsec_base44_placeholder
NEXT_PUBLIC_STRIPE_MONTHLY_PRICE_ID=price_base44_placeholder_monthly
NEXT_PUBLIC_STRIPE_YEARLY_PRICE_ID=price_base44_placeholder_yearly
MUX_TOKEN_ID=base44-placeholder
MUX_TOKEN_SECRET=base44-placeholder
MUX_WEBHOOK_SECRET=base44-placeholder
NEXT_PUBLIC_MUX_ENV_KEY=base44-placeholder
